# Always store LF in the repository; each checkout applies its own core.autocrlf.
# Without this, a diff sent from Windows arrives as one enormous line-ending change.
* text=auto eol=lf

# The Gradle wrapper batch file has to be CRLF on Windows.
*.bat text eol=crlf

# Binaries: no line-ending conversion, and keep them out of diffs.
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.apk binary
*.jks binary
